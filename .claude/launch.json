{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@liquidforge/studio"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "studio-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--workspace=@liquidforge/studio",
        "--",
        "-p",
        "3005"
      ],
      "port": 3005
    }
  ]
}
