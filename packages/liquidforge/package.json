{
  "name": "liquidforge",
  "version": "0.1.0",
  "description": "Liquid 3D hero sections for React. One component turns text, an SVG, an image, a shape or a .glb into a living chrome, glass or molten surface that reacts to the cursor.",
  "keywords": [
    "liquid",
    "chrome",
    "webgl",
    "shader",
    "three",
    "hero",
    "glsl",
    "3d",
    "metal",
    "glass",
    "iridescent",
    "landing-page",
    "generative"
  ],
  "license": "MIT",
  "author": "Meet Chauhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meet-1010/liquidforge.git"
  },
  "homepage": "https://github.com/Meet-1010/liquidforge#readme",
  "bugs": {
    "url": "https://github.com/Meet-1010/liquidforge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "liquidforge": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./forge": {
      "types": "./dist/forge.d.ts",
      "import": "./dist/forge.js",
      "require": "./dist/forge.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js",
      "require": "./dist/codegen.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.160"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/three": "^0.172.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
