{
  "name": "liquidforge",
  "version": "0.2.0",
  "description": "Liquid 3D hero sections for React. One component turns text, an SVG, an image, a shape or a .glb into a living chrome, glass or molten surface that reacts to the cursor.",
  "keywords": [
    "liquid",
    "chrome",
    "webgl",
    "shader",
    "three",
    "hero",
    "glsl",
    "3d",
    "metal",
    "glass",
    "iridescent",
    "landing-page",
    "generative"
  ],
  "license": "MIT",
  "author": "Meet Chauhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meet-1010/liquidforge.git"
  },
  "homepage": "https://github.com/Meet-1010/liquidforge#readme",
  "bugs": {
    "url": "https://github.com/Meet-1010/liquidforge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "liquidforge": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./forge": {
      "types": "./dist/forge.d.ts",
      "import": "./dist/forge.js",
      "require": "./dist/forge.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "require": "./dist/catalog.cjs"
    },
    "./recommend": {
      "types": "./dist/recommend.d.ts",
      "import": "./dist/recommend.js",
      "require": "./dist/recommend.cjs"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js",
      "require": "./dist/codegen.cjs"
    },
    "./placement": {
      "types": "./dist/placement.d.ts",
      "import": "./dist/placement.js",
      "require": "./dist/placement.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js",
      "require": "./dist/dev.cjs"
    },
    "./breed": {
      "types": "./dist/breed.d.ts",
      "import": "./dist/breed.js",
      "require": "./dist/breed.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./element.global.js": "./dist/element.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "registry"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node test/path.test.mjs && node test/breed.test.mjs && node test/route.test.mjs && node test/cli-add.test.mjs && node test/embed.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.160",
    "@types/three": ">=0.160"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/three": "^0.172.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  }
}
