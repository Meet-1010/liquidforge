{
  "name": "liquidforge-mcp",
  "version": "0.2.1",
  "description": "MCP server for Liquidforge — recommends and renders liquid 3D looks, reads a site's colours, and writes the React component or a Webflow, Framer or HTML embed.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "liquidforge",
    "liquid",
    "webgl",
    "shader",
    "three",
    "claude",
    "cursor",
    "codex",
    "agent"
  ],
  "license": "MIT",
  "author": "Meet Chauhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meet-1010/liquidforge.git",
    "directory": "packages/liquidforge-mcp"
  },
  "homepage": "https://liquidforge-pi.vercel.app/mcp",
  "bugs": {
    "url": "https://github.com/Meet-1010/liquidforge/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "liquidforge-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node scripts/smoke-test.mjs"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "liquidforge": "^0.2.1",
    "puppeteer-core": "^24.43.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "mcpName": "io.github.meet-1010/liquidforge",
  "exports": {
    ".": "./dist/index.js",
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  }
}
