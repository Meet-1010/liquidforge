# Copy to .env.local for local development, and set the same three on your host.
#
# On Vercel these must be scoped to **Production** as well as Preview. A
# variable added with only Preview ticked is invisible to the production
# functions, which then find no database, fall back to writing a file, and fail
# on a read-only filesystem with an ENOENT under /var/task. That is a confusing
# way to discover a checkbox, hence this file.

# Postgres. Use the POOLED connection string on serverless hosts — the one with
# "-pooler" in the host — because each function invocation opens its own
# connection and a direct endpoint runs out of them.
# Without this the gallery falls back to a JSON file under .data/, which is fine
# on your own machine and impossible on Vercel.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Salts the hash used to rate-limit submissions. The address itself is never
# stored. Changing this resets the rate-limit buckets and nothing else, so any
# long random string will do.
SUBMISSION_SALT=

# Bearer token for the takedown endpoint, PATCH /api/community/moderate.
MODERATION_TOKEN=
