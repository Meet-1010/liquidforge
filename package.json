{
  "name": "liquidforge-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Liquidforge — liquid 3D hero sections for React, plus an in-browser object forge.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=liquidforge",
    "build:mcp": "npm run build --workspace=liquidforge-mcp",
    "build:all": "npm run build && npm run build:mcp",
    "dev": "npm run dev --workspace=@liquidforge/studio",
    "dev:lib": "npm run dev --workspace=liquidforge",
    "studio": "npm run dev --workspace=@liquidforge/studio",
    "mcp": "npm run build:all && node packages/liquidforge-mcp/dist/index.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build:static": "npm run build:static --workspace=@liquidforge/studio"
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "MIT"
}
